# ---- Unity generated/cache folders (regenerated automatically, never commit) ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.vs/
.vsconfig

# Autogenerated IDE project/solution files - regenerated by Unity/Rider/VS on open
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash/analytics artifacts
sysinfo.txt
crashlytics-build.properties

# ---- Standalone build output ----
Linux/
Windows/
*.exe
*.x86_64
*.app

# ---- Python ----
__pycache__/
*.pyc

# ---- Local tooling state (not project content) ----
.claude/

# ---- Training outputs ----
# Trained model checkpoints/run artifacts and console logs are local-only.
results/

# hpc/: ignore everything by default, but keep directory traversal, analysis output graphs
# (*.png/*.jpg), and reusable traffic scripts. This excludes run logs (including *.out),
# checkpoints, and other generated binaries.
hpc/**
!hpc/**/
!hpc/**/*.png
!hpc/**/*.jpg
!hpc/**/*.jpeg
!hpc/traffic/*.py
!hpc/traffic/*.md
!hpc/traffic/*.sh

# progress0802/ predates the hpc/-wide whitelist above and had model checkpoints and full
# run logs committed directly - same "keep the analysis, not the training artifacts" rule,
# just as a blacklist here since the rest of the folder (notebooks/csv/png) stays trackable.
progress0802/**/*.onnx
progress0802/**/*.pt
progress0802/**/*.log
