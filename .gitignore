# ---- Unity generated/cache folders (regenerated automatically, never commit) ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.vs/
.vsconfig

# Autogenerated IDE project/solution files - regenerated by Unity/Rider/VS on open
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash/analytics artifacts
sysinfo.txt
crashlytics-build.properties

# ---- Standalone build output ----
Linux/
Windows/
*.exe
*.x86_64
*.app

# ---- Python ----
__pycache__/
*.pyc

# ---- Local tooling state (not project content) ----
.claude/

# ---- Training outputs ----
# Trained model checkpoints/run artifacts - not published, keep only the .out console logs
# from hpc/ below (whitelisted) as the record of what was run and how it went.
results/

# hpc/: ignore everything by default, but keep directory traversal, *.out files themselves
# (the plain-text console logs), and analysis-notebook output graphs (*.png/*.jpg) - excludes
# run_logs/ (Player-N.log, timers.json) and any other binaries.
hpc/**
!hpc/**/
!hpc/**/*.out
!hpc/**/*.png
!hpc/**/*.jpg
!hpc/**/*.jpeg
